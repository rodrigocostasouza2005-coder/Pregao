# Copie este arquivo para .streamlit/secrets.toml e preencha com valores reais.
# NUNCA commitar o secrets.toml de verdade (ja esta no .gitignore).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# gere um valor aleatorio: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "COLE_AQUI_UM_VALOR_ALEATORIO"
client_id = "COLE_AQUI_O_CLIENT_ID_DO_GOOGLE"
client_secret = "COLE_AQUI_O_CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://SEU-PROJETO.supabase.co"
# a nova secret key do Supabase, formato "sb_secret_..." (Project Settings > API Keys)
secret_key = "COLE_AQUI_A_SB_SECRET_KEY"

[groq]
# free tier em console.groq.com/keys - usado so pra resumir relatorios de
# research por IA; sem essa chave, a aba RESEARCH funciona normal (titulo+
# link), so sem os resumos automaticos
api_key = "COLE_AQUI_A_GROQ_API_KEY"
# opcional - so preencha se quiser trocar o modelo sem mexer em codigo
# (padrao: config.GROQ_MODELO_PADRAO). Util se a Groq descontinuar o
# modelo atual de novo - ja aconteceu uma vez.
# modelo = "openai/gpt-oss-20b"

[gemini]
# free tier em aistudio.google.com/apikey - usado SO pra gerar os
# embeddings da busca semantica da MEMORIA DE RESEARCH (RAG, Fase C do
# Equity Research Library). Sem essa chave, a busca degrada
# automaticamente pra so' lexical/estrutural (filtro por ticker/casa/tipo
# + correspondencia exata de palavra) - nunca quebra o app.
api_key = "COLE_AQUI_A_GEMINI_API_KEY"
# opcional - so preencha se quiser trocar o modelo de embedding sem mexer
# em codigo (padrao: config.GEMINI_MODELO_EMBEDDING_PADRAO). Mudar isso
# exige conferir se a dimensao do novo modelo ainda bate com o
# vector(768) de sql/research_embeddings.sql.
# modelo = "gemini-embedding-001"

[x]
# RADAR X - INTELIGENCIA SOCIAL (2026-10-30): NAO CONFIGURADO neste
# projeto - sem essa credencial, data/x_signals.py fica desligado de
# proposito (nunca simula coleta). Ver docs/x-radar-inteligencia-
# social-20261030.md pro custo real antes de assinar qualquer plano -
# o tier precisa incluir BUSCA/descoberta de posts recentes
# (/2/tweets/search/recent), nao so leitura de um post especifico.
# bearer_token = "COLE_AQUI_O_BEARER_TOKEN_DA_API_DO_X"
