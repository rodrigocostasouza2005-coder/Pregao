# Copie este arquivo para .streamlit/secrets.toml e preencha com valores reais.
# NUNCA commitar o secrets.toml de verdade (ja esta no .gitignore).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# gere um valor aleatorio: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "COLE_AQUI_UM_VALOR_ALEATORIO"
client_id = "COLE_AQUI_O_CLIENT_ID_DO_GOOGLE"
client_secret = "COLE_AQUI_O_CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "COLE_AQUI_A_SERVICE_ROLE_KEY"
