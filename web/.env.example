# Variáveis do terminal web. NUNCA versione valores reais: cadastre na
# Vercel (Settings -> Environment Variables) ou em .env.local (ignorado).
# Nenhuma delas tem prefixo NEXT_PUBLIC_ (exceto a URL do Streamlit),
# então nenhuma chega ao navegador.

# Banco: o MESMO projeto Supabase dos coletores (mesmos valores dos
# secrets SUPABASE_URL / SUPABASE_SECRET_KEY do GitHub Actions).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Login Google (obrigatório: sem ele o terminal fica bloqueado).
# Pode ser o mesmo cliente OAuth do Streamlit, com a URL de retorno da
# Vercel adicionada: https://SEU-DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# string aleatória longa (ex.: openssl rand -base64 32)
NEXTAUTH_SECRET=
# opcional na Vercel; obrigatório fora dela (ex.: http://localhost:3000)
NEXTAUTH_URL=

# E-mails administradores (separados por vírgula): veem detalhes de erro
# dos coletores em Configurações.
ADMIN_EMAILS=

# Opcional: atalho para o Pregão em Streamlit na barra lateral.
NEXT_PUBLIC_STREAMLIT_URL=
